# ============================================================
# SKILLA Frontend — Environment Variables
# Copia questo file in .env.local e compila i valori reali.
# IMPORTANTE: .env.local NON va mai committato su Git!
# ============================================================

# Supabase (ottenuto da https://supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...la-tua-chiave-pubblica

# Backend URL (in sviluppo: localhost, in produzione: Railway/Render URL)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# URL pubblica dell'app (per QR code e inviti)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics (opzionale)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
